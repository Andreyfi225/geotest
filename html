
<div id="toast" class="toast"></div>

<div id="settings" class="settings-panel">
  <div class="settings-head">
    <span>⚙️ Настройки</span>
    <button class="set-x" data-action="close-settings">×</button>
  </div>
  <div class="settings-body">
    <label class="switch-row">
      <span>🌗 Тёмная тема</span>
      <input type="checkbox" id="set-theme" class="switch" data-action="toggle-theme">
    </label>
    <label class="switch-row">
      <span>🔊 Звуки</span>
      <input type="checkbox" id="set-sound" class="switch" data-action="toggle-sound">
    </label>
    <button class="btn danger small" data-action="reset-data" style="width:100%;margin-top:15px">🗑️ Сбросить данные</button>
  </div>
</div>
