:root{--bg-0:#0f172a;--bg-1:#1e293b;--bg-2:#334155;--text-0:#e2e8f0;--text-1:#cbd5e1;--text-2:#94a3b8;--accent:#38bdf8;--accent-2:#22d3ee;--accent-soft:rgba(56,189,248,.15);--ok:#22c55e;--warn:#f59e0b;--danger:#ef4444;--border-soft:rgba(148,163,184,.15);--border-mid:rgba(148,163,184,.22);--map-ocean-1:#0c1f3d;--map-ocean-2:#050f20;--map-land-1:#2d5041;--map-land-2:#1a3128;--map-stroke:#4a7a64;--map-grid:rgba(56,189,248,.06);--map-eq:rgba(56,189,248,.22);--map-trop:rgba(56,189,248,.12);--map-label:rgba(255,255,255,.35)}
[data-theme="light"]{--bg-0:#f1f5f9;--bg-1:#e2e8f0;--bg-2:#cbd5e1;--text-0:#0f172a;--text-1:#1e293b;--text-2:#475569;--accent:#0284c7;--accent-2:#0891b2;--accent-soft:rgba(2,132,199,.12);--ok:#16a34a;--warn:#d97706;--danger:#dc2626;--border-soft:rgba(15,23,42,.1);--border-mid:rgba(15,23,42,.18);--map-ocean-1:#bfdbfe;--map-ocean-2:#93c5fd;--map-land-1:#86efac;--map-land-2:#4ade80;--map-stroke:#166534;--map-grid:rgba(2,132,199,.08);--map-eq:rgba(2,132,199,.3);--map-trop:rgba(2,132,199,.15);--map-label:rgba(15,23,42,.35)}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:var(--bg-0);color:var(--text-0);min-height:100vh;padding:20px 15px;display:flex;justify-content:center;transition:.3s}
#root{width:100%;max-width:800px}
.card{background:var(--bg-1);border:1px solid var(--border-soft);border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 10px 30px rgba(0,0,0,.2);animation:fi .3s ease}
@keyframes fi{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
h2,h3{text-align:center;margin-bottom:15px}
.muted{color:var(--text-2);font-size:14px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:10px}
.userinfo{display:flex;align-items:center;gap:10px;font-weight:600}
.btn{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:12px;font-weight:700;cursor:pointer;width:100%;margin-bottom:12px;font-size:15px;transition:.2s;font-family:inherit}
.btn:hover:not(:disabled){opacity:.9;transform:translateY(-2px)}
.btn.ghost{background:transparent;border:2px solid var(--border-mid);color:var(--text-0)}
.btn.danger{background:var(--danger)}
.btn.small{padding:8px 14px;font-size:14px;width:auto}
input,select{width:100%;padding:14px;margin-bottom:15px;border-radius:10px;border:1px solid var(--border-mid);background:var(--bg-0);color:var(--text-0);font-size:16px;outline:none;font-family:inherit}
.menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.menu-item{background:var(--bg-2);border:1px solid var(--border-soft);border-radius:12px;padding:16px;cursor:pointer;text-align:left;color:var(--text-0);transition:.2s;font-family:inherit}
.menu-item:hover{transform:translateY(-2px);border-color:var(--accent)}
.menu-item .icon{font-size:28px;display:block;margin-bottom:8px}
.menu-item .title{font-weight:700;font-size:16px;display:block}
.menu-item .desc{font-size:12px;color:var(--text-2);margin-top:4px;display:block}
.options{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px}
.option{background:var(--bg-2);border:2px solid transparent;padding:14px;border-radius:10px;cursor:pointer;color:var(--text-0);font-size:15px;font-weight:600;font-family:inherit;display:flex;align-items:center;gap:10px;transition:.2s}
.option:hover:not(:disabled){border-color:var(--accent)}
.option.correct{border-color:var(--ok);background:rgba(34,197,94,.1);color:var(--ok)}
.option.wrong{border-color:var(--danger);background:rgba(239,68,68,.1);color:var(--danger)}
.opt-num{background:var(--bg-1);padding:2px 8px;border-radius:6px;font-size:12px}
.flag-display{text-align:center;padding:20px;background:var(--bg-0);border-radius:12px;margin-bottom:15px}
.flag-display img{width:200px;border-radius:8px;box-shadow:0 4px 15px rgba(0,0,0,.3)}
.flag-question{text-align:center;font-size:18px;margin-bottom:10px}
.map-box{width:100%;height:300px;background:var(--bg-0);border-radius:12px;overflow:hidden;position:relative;border:1px solid var(--border-mid)}
svg.map{width:100%;height:100%;touch-action:none;cursor:crosshair}
.result-item{display:flex;justify-content:space-between;padding:10px;border-bottom:1px solid var(--border-soft);font-size:14px}
.toast{position:fixed;top:-50px;left:50%;transform:translateX(-50%);background:var(--bg-2);color:var(--text-0);padding:12px 24px;border-radius:10px;font-weight:700;transition:.3s;opacity:0;z-index:9999;box-shadow:0 5px 15px rgba(0,0,0,.3)}
.toast.show{top:20px;opacity:1}
.toast.ok{border-left:4px solid var(--ok)}
.toast.err{border-left:4px solid var(--danger)}
.settings-panel{position:fixed;top:0;right:-300px;width:300px;height:100vh;background:var(--bg-1);box-shadow:-5px 0 30px rgba(0,0,0,.3);transition:.3s;z-index:9998;display:flex;flex-direction:column}
.settings-panel.open{right:0}
.settings-head{display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid var(--border-soft);font-weight:700}
.set-x{background:none;border:none;color:var(--text-1);font-size:24px;cursor:pointer}
.settings-body{padding:20px;display:flex;flex-direction:column;gap:15px}
.switch-row{display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-weight:600}
.switch{appearance:none;width:44px;height:24px;background:var(--bg-2);border-radius:20px;position:relative;cursor:pointer;transition:.2s;margin:0}
.switch::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;background:#fff;border-radius:50%;transition:.2s}
.switch:checked{background:var(--accent)}
.switch:checked::after{transform:translateX(20px)}
@media(max-width:600px){.menu-grid{grid-template-columns:1fr}.options{grid-template-columns:1fr}} 
